<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default Blue theme -->
    <style name="Theme.FBClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fb_blue</item>
        <item name="colorPrimaryVariant">@color/fb_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/fb_blue</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@color/toolbar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dark theme -->
    <style name="Theme.FBClient.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1A1A2E</item>
        <item name="colorPrimaryVariant">#16213E</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">#0F0F0F</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- AMOLED Black theme -->
    <style name="Theme.FBClient.Amoled" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#111111</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
